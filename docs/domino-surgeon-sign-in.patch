+    ev = next(e for e in bus.events if e["type"] == "review.confirmed")
+    assert ev["approved_by"] == {"user": "m.castillo", "name": "Dr. M. Castillo", "role": "transplant_surgeon"} and ev["who"] == "alder-ui"
