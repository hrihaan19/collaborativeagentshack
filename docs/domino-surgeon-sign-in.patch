+"""Offline tests for the surgeon sign-in: the password store, lockout, sessions, and the bridge's gate on /ui."""
+import http.client
+import json
+import sys
+import threading
+import types
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "bridge"))
+
+import auth  # noqa: E402
+import bridge  # noqa: E402
+
+FAST = 1000  # PBKDF2 rounds for tests; the real store uses auth.ITERATIONS
+CONFIRM = {"type": "review.confirmed", "request_id": "REQ-2026-0929-A1", "candidate_token": "HP-39AEF0", "surgeon": "Dr. M. Castillo"}
+
+
+class Clock:
+    def __init__(self):
+        self.t = 1000.0
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.fixture
+def staff(tmp_path):
+    s = auth.Staff(tmp_path / "staff.json", iterations=FAST, clock=Clock())
+    s.add("m.castillo", "Dr. M. Castillo", "transplant_surgeon", "alder-2026")
+    return s
+
+
+def test_password_roundtrip(staff):
+    assert staff.verify("m.castillo", "alder-2026") == {"user": "m.castillo", "name": "Dr. M. Castillo", "role": "transplant_surgeon"}
+    assert staff.verify("m.castillo", "wrong") is None
+    assert staff.verify("nobody", "alder-2026") is None
+    assert staff.verify("", "") is None
+
+
+def test_file_holds_hashes_not_passwords(staff):
+    text = staff.path.read_text()
+    assert "alder-2026" not in text and '"hash"' in text and '"salt"' in text
+    again = auth.Staff(staff.path, iterations=FAST)  # reloads from disk
+    assert again.verify("m.castillo", "alder-2026")
+
+
+def test_add_validates(staff):
+    with pytest.raises(ValueError):
+        staff.add("Dr Castillo", "x", "transplant_surgeon", "alder-2026")  # bad user name
+    with pytest.raises(ValueError):
+        staff.add("a.b", "x", "janitor", "alder-2026")  # unknown role
+    with pytest.raises(ValueError):
+        staff.add("a.b", "x", "transplant_surgeon", "short")  # short password
+    assert staff.remove("m.castillo") and not staff.remove("m.castillo")
+
+
+def test_lockout_after_five_wrong_passwords(staff):
+    for _ in range(4):
+        assert staff.verify("m.castillo", "wrong") is None
+    with pytest.raises(auth.Locked) as lock:
+        staff.verify("m.castillo", "wrong")
+    assert lock.value.retry_after == auth.LOCK_SECONDS
+    with pytest.raises(auth.Locked):
+        staff.verify("m.castillo", "alder-2026")  # right password, still locked
+    staff.clock.t += auth.LOCK_SECONDS + 1
+    assert staff.verify("m.castillo", "alder-2026")
+
+
+def test_sessions_idle_out_and_revoke():
+    clock = Clock()
+    s = auth.Sessions(idle_seconds=60, clock=clock)
+    tok = s.issue({"user": "u", "name": "N", "role": "transplant_surgeon", "salt": "x", "hash": "y"})
+    assert s.get(tok) == {"user": "u", "name": "N", "role": "transplant_surgeon"}  # no salt or hash in a session
+    clock.t += 59
+    assert s.get(tok)  # a request inside the idle window keeps it alive
+    clock.t += 61
+    assert s.get(tok) is None
+    tok2 = s.issue({"user": "u", "name": "N", "role": "transplant_surgeon"})
+    s.revoke(tok2)
