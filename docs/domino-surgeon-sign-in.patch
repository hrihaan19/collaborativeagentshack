+++ b/bridge/auth.py
@@ -0,0 +1,179 @@
+"""Surgeon sign-in for the coordinator bridge (Mac A).  Standard library only.
+
+Accounts live in Alder's own pod (pods/alder/staff.json) and never leave that machine.  Passwords are stored
+as salted PBKDF2-HMAC-SHA256 hashes.  Sessions live in memory: one ends when the surgeon signs out, after
+IDLE_SECONDS without a request, or when the bridge stops.
+
+    python3 bridge/auth.py add m.castillo --name "Dr. M. Castillo" --role transplant_surgeon   # prompts for a password
+    python3 bridge/auth.py list
+    python3 bridge/auth.py remove m.castillo
+"""
+from __future__ import annotations
+
+import argparse
+import getpass
+import hashlib
+import hmac
+import json
+import os
+import re
+import secrets
+import time
+from pathlib import Path
+
+ITERATIONS = 210_000
+IDLE_SECONDS = 20 * 60
+MAX_FAILURES = 5
+LOCK_SECONDS = 60
+ROLES = ("transplant_surgeon", "coordinator")
+CONFIRM_ROLE = "transplant_surgeon"  # the only role that may confirm an approval (AMC-KTP-04 §2.4)
+COOKIE = "domino_session"
+
+
+class Locked(Exception):
+    """Too many wrong passwords for this account; try again after `retry_after` seconds."""
+
+    def __init__(self, retry_after: int):
+        super().__init__(f"locked for {retry_after} s")
+        self.retry_after = retry_after
+
+
+def hash_password(password: str, salt_hex: str, iterations: int = ITERATIONS) -> str:
+    return hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), bytes.fromhex(salt_hex), iterations).hex()
+
+
+def same_person(a: str, b: str) -> bool:
+    """'Dr. M. Castillo' is 'dr m castillo': compare names ignoring case, punctuation and spacing."""
+    norm = lambda s: re.sub(r"[^a-z0-9]", "", str(s or "").casefold())  # noqa: E731
+    return bool(norm(a)) and norm(a) == norm(b)
+
+
+def public(account: dict) -> dict:
+    return {"user": account["user"], "name": account["name"], "role": account["role"]}
+
+
+class Staff:
+    """The accounts file, plus a wrong-password counter per account."""
+
+    def __init__(self, path: str | os.PathLike, iterations: int = ITERATIONS, clock=time.monotonic):
+        self.path = Path(path)
+        self.iterations, self.clock = iterations, clock
+        self.accounts: dict[str, dict] = {}
+        self.failures: dict[str, list] = {}  # user -> [wrong attempts, locked until]
+        self.load()
+
+    def load(self) -> None:
+        if self.path.exists():
+            data = json.loads(self.path.read_text(encoding="utf-8"))
+            self.accounts = {a["user"]: a for a in data.get("accounts", [])}
+        else:
+            self.accounts = {}
+
+    def save(self) -> None:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        data = {"hospital": "alder", "synthetic": True, "accounts": list(self.accounts.values())}
+        self.path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
+
+    def add(self, user: str, name: str, role: str, password: str) -> dict:
+        if not re.fullmatch(r"[a-z0-9._-]{2,32}", user or ""):
+            raise ValueError("user: 2 to 32 of a-z, 0-9, dot, underscore, dash")
+        if role not in ROLES:
+            raise ValueError(f"role must be one of {', '.join(ROLES)}")
+        if len(password or "") < 8:
+            raise ValueError("password: at least 8 characters")
+        if not (name or "").strip():
+            raise ValueError("name: required")
+        salt = secrets.token_hex(16)
+        self.accounts[user] = {"user": user, "name": name.strip(), "role": role, "salt": salt,
+                               "iterations": self.iterations, "hash": hash_password(password, salt, self.iterations)}
+        self.save()
+        return public(self.accounts[user])
+
+    def remove(self, user: str) -> bool:
+        gone = self.accounts.pop(user, None) is not None
+        if gone:
+            self.save()
+        return gone
+
+    def verify(self, user: str, password: str) -> dict | None:
+        """The account's public fields if the password is right, None if not.  Raises Locked after MAX_FAILURES."""
+        user = str(user or "").strip()
+        now = self.clock()
+        count, until = self.failures.get(user, [0, 0.0])
+        if until > now:
+            raise Locked(int(until - now) + 1)
+        account = self.accounts.get(user)
+        if account:
+            ok = hmac.compare_digest(hash_password(password or "", account["salt"], account.get("iterations", self.iterations)),
+                                     account["hash"])
+        else:  # spend the same time on an unknown user, so the reply does not say which names exist
+            hash_password(password or "", "00" * 16, self.iterations)
+            ok = False
+        if ok:
+            self.failures.pop(user, None)
+            return public(account)
+        count += 1
+        if count >= MAX_FAILURES:
+            self.failures[user] = [0, now + LOCK_SECONDS]
+            raise Locked(LOCK_SECONDS)
+        self.failures[user] = [count, 0.0]
+        return None
+
+
+class Sessions:
+    """Signed-in surgeons, by opaque token.  Idle sessions expire; every request extends the one it carries."""
+
+    def __init__(self, idle_seconds: int = IDLE_SECONDS, clock=time.monotonic):
+        self.idle, self.clock = idle_seconds, clock
+        self.live: dict[str, dict] = {}
+
+    def issue(self, account: dict) -> str:
+        token = secrets.token_urlsafe(32)
+        self.live[token] = {**public(account), "expires": self.clock() + self.idle}
+        return token
+
+    def get(self, token: str | None) -> dict | None:
+        session = self.live.get(token or "")
+        if not session:
+            return None
+        if session["expires"] <= self.clock():
+            self.live.pop(token, None)
+            return None
+        session["expires"] = self.clock() + self.idle
+        return public(session)
+
+    def revoke(self, token: str | None) -> None:
+        self.live.pop(token or "", None)
+
+
+def main() -> None:
+    root = Path(__file__).resolve().parents[1]
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("--staff", default=str(root / "pods" / "alder" / "staff.json"), help="accounts file (default: pods/alder/staff.json)")
+    sub = p.add_subparsers(dest="cmd", required=True)
+    a = sub.add_parser("add", help="add or replace an account; the password is prompted for, or read from $DOMINO_PASSWORD")
+    a.add_argument("user")
+    a.add_argument("--name", required=True, help='as printed on the approval form, e.g. "Dr. M. Castillo"')
+    a.add_argument("--role", default=CONFIRM_ROLE, choices=ROLES)
+    sub.add_parser("list", help="show the accounts (never the hashes)")
+    r = sub.add_parser("remove")
+    r.add_argument("user")
+    args = p.parse_args()
+    staff = Staff(args.staff)
+    if args.cmd == "add":
+        password = os.environ.get("DOMINO_PASSWORD") or getpass.getpass("Password (8+ characters): ")
+        if not os.environ.get("DOMINO_PASSWORD") and getpass.getpass("Again: ") != password:
+            raise SystemExit("passwords differ")
+        account = staff.add(args.user, args.name, args.role, password)
+        print(f"saved {account['user']} · {account['name']} · {account['role']} → {staff.path}")
+    elif args.cmd == "list":
+        for acc in staff.accounts.values():
+            print(f"{acc['user']:<16} {acc['role']:<20} {acc['name']}")
+        if not staff.accounts:
+            print(f"no accounts in {staff.path}")
+    elif args.cmd == "remove":
+        print("removed" if staff.remove(args.user) else "no such user")
+
+
+if __name__ == "__main__":
+    main()
