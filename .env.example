# Domino - copy to .env and fill in. No hardcoded IPs anywhere else.
# SYNTHETIC DEMO - NOT A CLINICAL MATCHING TOOL

# Coordinator (Nebius VM; fallback M1). Hospitals only ever connect OUT to this.
COORDINATOR_HOST=203.0.113.10
SUPERLINK_FLEET_PORT=9092
SUPERLINK_CONTROL_PORT=9093
COORDINATOR_API_PORT=8001
DASHBOARD_PORT=8501
QR_PORT=8020
# LAN-reachable URL of the QR page host (what phones will open)
PUBLIC_URL=http://203.0.113.10:8020

# Hospital side (127.0.0.1 only; ZERO inbound ports)
HOSPITAL_CONSOLE_PORT=8010
SUPERNODE_PORT=9094

# Optional local model at a hospital machine (direct call, never via the coordinator)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Polling / timeouts (seconds)
POLL_SECONDS=5
ROUND_TIMEOUT=60
